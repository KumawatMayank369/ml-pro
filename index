@app.route("/api/predict/ipl", methods=["POST"])
def predict_ipl():
    model, scaler, meta = load("ipl")
    payload = dict(request.json)
    try:
        payload["toss_won_by_team1"] = 1 if payload.get("toss_winner") == payload.get("team1") else 0
        # feature keys in meta are e.g. "team1_enc" but encoders are keyed "team1"
        renamed = {}
        for k, v in payload.items():
            if f"{k}_enc" in meta["features"]:
                renamed[f"{k}_enc"] = v
            else:
                renamed[k] = v
        result = classify_response(model, scaler, meta, renamed)
        team1_wins = result["prediction"] == 1
        result["predicted_winner"] = payload.get("team1") if team1_wins else payload.get("team2")
        return jsonify(result)
    except ValueError as e:
        return jsonify({"error": str(e)}), 400


