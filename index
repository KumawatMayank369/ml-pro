@app.route("/api/predict/loan", methods=["POST"])
def predict_loan():
    model, scaler, meta = load("loan")
    payload = dict(request.json)
    try:
        income = float(payload.get("ApplicantIncome", 0)) + float(payload.get("CoapplicantIncome", 0))
        payload["TotalIncome_log"] = np.log1p(income)
        payload["LoanAmount_log"] = np.log1p(float(payload.get("LoanAmount", 0)))
        return jsonify(classify_response(model, scaler, meta, payload))
    except ValueError as e:
        return jsonify({"error": str(e)}), 400


